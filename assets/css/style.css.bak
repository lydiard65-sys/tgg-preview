/* Truckin' Good Gear — preview site styles */
:root{--bg:#11151b;--bg2:#17202a;--card:#19212b;--line:#2b3948;--text:#eef1f5;--muted:#aeb8c4;--blue:#60b4f7;--blue2:#66b8ff;--hivis:#e6ff2e;--chrome:#c9d3dd;--ink:#0c1722}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 "Helvetica Neue",Arial,sans-serif}
img{max-width:100%;display:block}
a{color:inherit}
.inner{width:88%;max-width:1240px;margin:auto}
.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;z-index:99;background:var(--hivis);color:#000;padding:8px 12px}
/* notice bar */
.notice-bar{background:var(--hivis);color:#11151b;text-align:center;font-size:12px;font-weight:700;letter-spacing:.5px;padding:7px 4%}
.notice-bar a{text-decoration:underline}
/* header */
.site-header{background:#11151bf2;position:sticky;top:0;z-index:20;border-bottom:1px solid #303640;backdrop-filter:blur(6px)}
.site-header .inner{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 0}
.brand{font-weight:900;font-style:italic;line-height:.95;font-size:20px;letter-spacing:-1px;text-decoration:none;text-transform:uppercase}
.brand span{display:block;color:var(--blue2);font-size:13px;letter-spacing:3px;margin-top:6px}
.nav{display:flex;gap:22px;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1px}
.nav a{text-decoration:none;color:#c4ced9;padding:6px 0;border-bottom:2px solid transparent}
.nav a:hover,.nav a[aria-current=page]{color:#fff;border-bottom-color:var(--blue)}
.nav-toggle{display:none;background:none;border:1px solid #3a4756;color:#fff;padding:8px 12px;font-weight:700;cursor:pointer}
/* type */
h1,h2,h3{line-height:1.04;margin:16px 0;font-weight:900;font-style:italic;text-transform:uppercase}
h1{font-size:clamp(46px,6.4vw,88px);letter-spacing:-2px}
h1 em,h2 em{color:var(--blue2);font-style:inherit}
h2{font-size:clamp(30px,3.8vw,50px);letter-spacing:-1px}
h3{font-size:22px;letter-spacing:-.3px}
p{color:var(--muted)}
.pill{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#a9bdce;font-weight:700}
.pill.hv{color:var(--hivis)}
.small{font-size:12px}
.tbc{color:var(--hivis);font-weight:700}
/* buttons */
.button,button.button{display:inline-block;background:var(--blue);border:1px solid var(--blue);color:var(--ink);padding:13px 22px;font-weight:800;font-size:13px;letter-spacing:.5px;text-transform:uppercase;text-decoration:none;cursor:pointer;border-radius:2px;font-family:inherit}
.button:hover{filter:brightness(1.08)}
.button.outline{background:transparent;color:#e1eaf3;border-color:#536171}
.button.hv{background:var(--hivis);border-color:var(--hivis);color:#11151b}
.button[disabled],.button.disabled{background:#2a3440;border-color:#3a4756;color:#9fb0c1;cursor:not-allowed}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
/* sections */
.section{padding:70px 0}
.section.alt{background:var(--bg2);border-block:1px solid #26313d}
.head{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap}
.head p{max-width:380px;font-size:14px}
.page-head{padding:55px 0 10px;background:radial-gradient(ellipse at 85% 0%,#244c7044,transparent 60%)}
.page-head p{max-width:640px}
/* hero */
.hero{background:radial-gradient(ellipse at 80% 30%,#244c7055,transparent 60%);padding:55px 0 50px}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:30px}
.hero p.lead{max-width:470px;font-size:17px}
.hero-art img{width:100%;height:auto;aspect-ratio:1000/1094;object-fit:contain;filter:drop-shadow(0 20px 45px #0008);border-radius:4px}
.art-label{font-size:10px;text-align:right;color:#8095a7;letter-spacing:2px;margin-top:8px}
.strip{border-block:1px solid #303b47;padding:18px 6%;display:flex;justify-content:space-between;gap:20px;font-size:11px;letter-spacing:2px;color:#adc6db;font-weight:700}
.strip span:nth-child(2){color:var(--hivis)}
/* product grid */
.filters{display:flex;gap:9px;flex-wrap:wrap;margin:22px 0 28px}
.filters button{background:#1b232e;color:#c4ced9;border:1px solid #354455;padding:9px 16px;font:700 12px/1 inherit;letter-spacing:1px;text-transform:uppercase;cursor:pointer;border-radius:2px}
.filters button.active{background:var(--blue);color:var(--ink);border-color:var(--blue)}
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.product{background:var(--card);border:1px solid var(--line);display:flex;flex-direction:column;transition:border-color .2s,transform .2s}
.product:hover{border-color:#4d6a86;transform:translateY(-2px)}
.product[hidden]{display:none}
.product .media{display:block;aspect-ratio:1/1;background:#e5e5e5;overflow:hidden}
.product .media.dark{background:#0d1116}
.product .media img{width:100%;height:100%;object-fit:contain}
.product-body{padding:20px 22px 22px;display:flex;flex-direction:column;flex:1}
.product h3{margin:8px 0 8px;font-size:21px}
.product h3 a{text-decoration:none}
.product p{font-size:14px;margin:0 0 12px}
.product .price{color:#fff;font-weight:800;font-size:15px;margin-top:auto}
.product .price small{color:var(--hivis);font-weight:700;font-size:11px;letter-spacing:.5px}
.product .button{margin-top:14px;align-self:flex-start;padding:10px 16px;font-size:12px}
.tag{color:#7ec5ff;font-size:10px;letter-spacing:2px;font-weight:700;text-transform:uppercase}
.dock-mark{aspect-ratio:1/1;background:linear-gradient(150deg,#101820,#172d43 52%,#0d1219);display:grid;place-items:center;position:relative;overflow:hidden;text-decoration:none}
.dock-mark:before,.dock-mark:after{content:"";position:absolute;border:1px solid #53728c55;inset:12% 8%;transform:skewY(-8deg)}
.dock-mark:after{inset:24% 16%;border-color:#60b4f755}
.dock-mark span{text-transform:uppercase;position:relative;z-index:1;font-size:clamp(34px,4vw,54px);line-height:1;font-weight:900;font-style:italic;letter-spacing:-2px;color:#f2f6fa;text-shadow:0 3px 0 #1f6fb0,0 12px 30px #000;text-align:center}
.dock-mark small{position:absolute;bottom:20px;left:0;right:0;text-align:center;color:#a9bdce;font-size:10px;letter-spacing:3px;text-transform:uppercase}
/* coming soon strip */
.planned{border:1px solid #344457;margin-top:34px;padding:24px;display:grid;grid-template-columns:1fr 2fr;gap:24px;background:#141b23}
.planned h3{margin-top:6px}
.chips{display:flex;flex-wrap:wrap;gap:10px;align-content:center}
.chips span{padding:8px 14px;background:#202d3a;font-size:13px;font-weight:700;border-left:3px solid var(--hivis)}
/* teasers */
.teaser{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
.custom-band{background:#deebf4;color:#142431}
.custom-band p{color:#465d70}
.custom-band .pill{color:#375b76}
.custom-band h2 em{color:#1f6fb0}
.slogan-list{display:flex;flex-wrap:wrap;gap:8px}
.slogan-list span{background:#11151b;color:#fff;font-weight:900;font-style:italic;padding:8px 12px;font-size:14px;letter-spacing:.3px}
.mates{padding:50px;background:linear-gradient(120deg,#163d47,#362a4f);border:1px solid #427d89}
.mates h2,.mates h3{max-width:700px}
.mates p{max-width:640px;color:#c1d4df}
.mates .pill{color:#8fe3e8}
/* product page */
.crumbs{font-size:12px;color:#8fa2b4;padding-top:24px}
.crumbs a{color:#b9c9d8}
.pdp{display:grid;grid-template-columns:1.1fr 1fr;gap:50px;padding:24px 0 70px;align-items:start}
.pdp-media{background:#e5e5e5;border:1px solid var(--line);position:sticky;top:100px}
.pdp-media.dark{background:#0d1116}
.pdp-media img{width:100%;height:auto;margin:auto;max-height:78vh;object-fit:contain}
.pdp h1{font-size:clamp(38px,4.6vw,62px);margin-top:8px}
.price-big{font-size:26px;font-weight:900;color:#fff;margin:10px 0 2px}
.price-big small{font-size:13px;color:var(--hivis);letter-spacing:.5px}
.opt{margin:22px 0}
.opt-label{font-size:12px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:#c4ced9;margin-bottom:10px;display:block}
.opt-label output{color:var(--blue2);margin-left:6px}
.sizes,.swatches{display:flex;flex-wrap:wrap;gap:8px;border:0;padding:0;margin:0}
.sizes button,.swatches button{min-width:54px;padding:10px 12px;background:#1b232e;color:#e1eaf3;border:1px solid #3a4a5c;font:800 13px/1 inherit;cursor:pointer;border-radius:2px}
.swatches button{display:flex;align-items:center;gap:8px;text-transform:none;font-weight:700}
.swatches i{width:18px;height:18px;border-radius:50%;border:1px solid #fff6;display:inline-block;flex:none}
.sizes button[aria-pressed=true],.swatches button[aria-pressed=true]{background:var(--blue);color:var(--ink);border-color:var(--blue)}
.buy-note{font-size:12px;margin-top:10px}
.specs{border-top:1px solid #2c3947;margin-top:28px;padding-top:12px}
.specs li{color:var(--muted);font-size:14px;margin:6px 0}
/* forms */
.form{background:#fff;color:#142431;padding:30px;border:1px solid #c6d8e7}
.form.dark{background:var(--card);color:var(--text);border-color:var(--line)}
label{display:block;font-size:12px;margin:16px 0 6px;font-weight:800;letter-spacing:.5px;text-transform:uppercase}
select,input,textarea{width:100%;padding:12px;border:1px solid #bdcbd5;background:#f4f8fa;font:15px "Helvetica Neue",Arial,sans-serif;color:#142431;border-radius:2px}
.form.dark select,.form.dark input,.form.dark textarea{background:#0f151c;border-color:#3a4a5c;color:#eef1f5}
textarea{min-height:120px;resize:vertical}
input[type=file]{font-size:13px;padding:10px}
.hint{font-size:12px;color:#64798b;margin:6px 0 0}
.form.dark .hint{color:#8fa2b4}
.hidden-field{display:none}
.custom-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
.preview-box{background:#11151b;border:1px solid var(--line);padding:24px;text-align:center;position:sticky;top:100px}
.preview-box .pv-slogan{font-weight:900;font-style:italic;text-transform:uppercase;font-size:clamp(24px,3vw,38px);line-height:1.05;color:#fff;text-shadow:0 3px 0 #1f6fb0;margin:10px 0 16px}
.preview-box .pv-photo{aspect-ratio:4/3;background:#0b0f14;border:1px dashed #3a4a5c;display:grid;place-items:center;color:#6f8396;font-size:13px;overflow:hidden}
.preview-box .pv-photo img{width:100%;height:100%;object-fit:contain}
.preview-box .pv-meta{font-size:13px;color:#aeb8c4;margin-top:14px}
.placeholder{background:#2a2410;border:1px dashed var(--hivis);color:var(--hivis);padding:3px 8px;font-weight:800;font-size:13px;display:inline-block}
.draft{background:var(--hivis);color:#11151b;font-weight:900;padding:6px 12px;display:inline-block;letter-spacing:1px;font-size:12px;text-transform:uppercase}
.policy{max-width:820px}
.policy section{border-top:1px solid #2c3947;padding:26px 0}
.policy h2{font-size:30px}
.policy li{color:var(--muted);margin:6px 0}
.policy-nav{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}
.policy-nav a{background:#1b232e;border:1px solid #354455;padding:8px 14px;text-decoration:none;font-weight:700;font-size:13px}
details{border-bottom:1px solid #2c3947;padding:12px 0}
summary{cursor:pointer;font-weight:800}
details p{margin:8px 0 0}
.story{display:grid;grid-template-columns:1.2fr 1fr;gap:60px}
.story-right{border-left:2px solid var(--blue);padding-left:32px}
.collection{list-style:none;padding:0;margin:0}
.collection li{font-weight:900;font-style:italic;text-transform:uppercase;font-size:22px;padding:8px 0;border-bottom:1px solid #26313d}
.collection li small{display:block;font-style:normal;font-weight:400;text-transform:none;font-size:13px;color:var(--muted)}
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:50px;align-items:start}
/* footer */
.site-footer{border-top:1px solid #303b47;background:#0d1116;padding:40px 0 30px;font-size:13px;color:#90a3b6}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:30px}
.site-footer h4{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#c4ced9;margin:0 0 10px}
.site-footer ul{list-style:none;padding:0;margin:0}
.site-footer li{margin:5px 0}
.site-footer a{text-decoration:none;color:#b9c9d8}
.site-footer a:hover{color:#fff}
.foot-base{border-top:1px solid #222c37;margin-top:28px;padding-top:16px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:12px}
/* responsive */
@media(max-width:980px){.products{grid-template-columns:1fr 1fr}.pdp{grid-template-columns:1fr;gap:24px}.pdp-media,.preview-box{position:static}}
@media(max-width:760px){
 .nav-toggle{display:block}
 .nav{display:none;position:absolute;left:0;right:0;top:100%;background:#11151b;flex-direction:column;gap:0;padding:6px 6%;border-bottom:1px solid #303640}
 .nav.open{display:flex}.nav a{padding:12px 0;border-bottom:1px solid #222c37}
 .site-header .inner{position:relative}
 .hero-grid,.teaser,.custom-grid,.story,.contact-grid,.foot-grid,.planned{grid-template-columns:1fr;gap:26px}
 .hero{padding-top:30px}.hero-art{max-width:440px;margin:auto}
 .strip{font-size:9px;letter-spacing:1px}.strip span:nth-child(3){display:none}
 .products{grid-template-columns:1fr;gap:16px}
 .section{padding:48px 0}.mates{padding:26px}
 .story-right{border-left:0;border-top:2px solid var(--blue);padding:20px 0 0}
 .form{padding:20px}
}
/* Cartoon range + custom example */
.products.cols4{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:1100px){.products.cols4{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:820px){.products.cols4{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.products.cols4{grid-template-columns:1fr}}
.custom-example{margin:22px 0 0}.custom-example img{width:100%;height:auto;border-radius:12px;display:block}
.custom-example figcaption{margin-top:8px}
.art-slot img{width:100%;height:auto;display:block}
.products.cols4 .dock-mark span{font-size:clamp(24px,2.4vw,36px);overflow-wrap:anywhere}
